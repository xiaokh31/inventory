{
  "name": "bestar-warehouse-map",
  "version": "2.0.0",
  "private": true,
  "engines": { "node": "24.x" },
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "node scripts/serve.cjs",
    "test": "node --test tests/model.test.cjs tests/build.test.cjs tests/i18n.test.cjs",
    "test:database": "node --test tests/database.test.cjs",
    "db:migrate": "node scripts/migrate.cjs",
    "docker:up": "docker compose --env-file .env.docker up -d --build --wait app",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:test": "docker compose --env-file .env.docker --profile test run --build --rm test"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
