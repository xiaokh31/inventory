# Copy to .env.docker or use node scripts/docker-env.cjs to generate random secrets.
# POSTGRES_PASSWORD is used in a URL; use at least 32 random hexadecimal characters.
POSTGRES_PASSWORD=replace_with_random_hex_password
BIND_ADDRESS=127.0.0.1
APP_PORT=4173
APP_ORIGIN=
# Only needed with compose.https.yaml, without https:// or a path.
PUBLIC_HOST=
